import type { VbenFormSchema } from '@vben/common-ui';
import type { VxeGridProps } from '#/adapter/vxe-table';
import { h } from 'vue';
import { DictEnum } from '@vben/constants';
import { getPopupContainer } from '@vben/utils';
import { getDictOptions } from '#/utils/dict';
import { renderDict } from '#/utils/render';

/**
 * 搜索表单配置
 */
export const querySchema = (): VbenFormSchema[] => [
    #foreach($column in $columns)
        #if($column.query)
            #set($dictType=$column.dictType)
            {
                fieldName: '${column.javaField}',
                label: '${column.columnComment}',
                #if($column.dictType != "")
                    component: 'Select',
                    componentProps: {
                        getPopupContainer,
                        options: getDictOptions(DictEnum.${dictType.toUpperCase()}),
                        allowClear: true,
                    },
                #elseif($column.htmlType == "datetime")
                    component: 'DatePicker',
                #else
                    component: 'Input',
                #end
            },
        #end
    #end
];

/**
 * 表格列配置
 */
export const columns: VxeGridProps['columns'] = [
    { type: 'checkbox', width: 50 },
    #foreach($column in $columns)
        #if($column.list)
            #if($column.pk)
                { field: '${column.javaField}', title: '${column.columnComment}', width: 100 },
            #elseif($column.dictType != "")
                {
                    field: '${column.javaField}',
                    title: '${column.columnComment}',
                    slots: {
                        default: ({ row }) => {
                            return renderDict(row.${column.javaField}, DictEnum.${column.dictType.toUpperCase()});
                        },
                    },
                },
            #else
                { field: '${column.javaField}', title: '${column.columnComment}' },
            #end
        #end
    #end
    {
        field: 'action',
        fixed: 'right',
        slots: { default: 'action' },
        title: '操作',
        width: 160,
    },
];

/**
 * 弹窗表单配置 (新增/修改)
 */
export const modalSchema = (): VbenFormSchema[] => [
    #foreach($column in $columns)
        #if($column.pk)
            {
                fieldName: '${column.javaField}',
                label: '${column.columnComment}',
                component: 'Input',
                dependencies: {
                    show: () => false,
                    triggerFields: [''],
                },
            },
        #elseif(($column.insert || $column.edit) && !$column.superColumn)
            {
                fieldName: '${column.javaField}',
                label: '${column.columnComment}',
                #if($column.dictType != "")
                    component: 'Select',
                    componentProps: {
                        getPopupContainer,
                        options: getDictOptions(DictEnum.${column.dictType.toUpperCase()}),
                    },
                #elseif($column.htmlType == "inputNumber")
                    component: 'InputNumber',
                #elseif($column.htmlType == "datetime")
                    component: 'DatePicker',
                #elseif($column.htmlType == "textarea")
                    component: 'Input',
                    componentProps: {
                        type: 'textarea',
                    },
                #else
                    component: 'Input',
                #end
                #if($column.required)
                    rules: 'required',
                #end
            },
        #end
    #end
];
